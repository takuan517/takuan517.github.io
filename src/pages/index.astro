    <a class="back-to-top" href="#about" aria-label="Back to top">↑</a>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const updateThemeLabel = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        themeButton?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`);
      };
      updateThemeLabel();
      themeButton?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('portfolio-theme', theme); } catch {}
        updateThemeLabel();
      });
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector('#navigation');
      const closeMenu = () => {
        navigation?.classList.remove('open');
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Open navigation');
      };
      menuButton?.addEventListener('click', () => {
        const open = navigation?.classList.toggle('open');
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
      navigation?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('#navigation a')];
      const targets = navLinks.map(link => document.querySelector(link.hash)).filter((el): el is Element => Boolean(el));
      const updateNavigation = () => {
        const current = [...targets].reverse().find(target => target.getBoundingClientRect().top <= 140) ?? targets[0];
        navLinks.forEach(link => {
          const active = link.hash === `#${current?.id}`;
          link.classList.toggle('active', active);
          if (active) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
        document.querySelector('.back-to-top')?.classList.toggle('visible', scrollY > 350);
      };
      window.addEventListener('scroll', updateNavigation, { passive: true });
      updateNavigation();
    </script>

    <style>
      :global(*) { box-sizing: border-box; }
      :global(:root) {
        color-scheme: light;
        --background: #fff;
        --text: #1a1a1a;
        --muted: #6c757d;
        --accent: #b509ac;
        --divider: #0000001a;
      }
      :global(html[data-theme="dark"]) {
        color-scheme: dark;
        --background: #1c1c1d;
        --text: #e0e0e0;
        --muted: #aaa;
        --accent: #2698ba;
        --divider: #424246;
      }
      html { scroll-behavior: smooth; scroll-padding-top: 90px; }
      body { margin: 0; background: var(--background); color: var(--text); font-family: "Helvetica Neue", Arial, "Noto Sans JP", sans-serif; font-size: 16px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
      a { color: var(--accent); text-decoration: none; text-underline-offset: 3px; }
      a:hover { text-decoration: underline; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
      .navbar { position: fixed; inset: 0 0 auto; z-index: 20; height: 57px; background: var(--background); border-bottom: 1px solid var(--divider); }
      .nav-inner, main, .footer-inner { width: 100%; max-width: 930px; margin: 0 auto; padding-inline: 16px; }
      .nav-inner, .nav-controls, nav { display: flex; align-items: center; }
      .nav-inner { height: 100%; justify-content: space-between; gap: 16px; }
      .brand { color: var(--text); font-weight: 700; font-size: 18px; white-space: nowrap; }
      .brand:hover { text-decoration: none; }
      .nav-controls { gap: 12px; }
      nav { gap: 20px; }
      nav a { color: var(--text); font-size: 14px; }
      nav a.active { color: var(--accent); font-weight: 700; }
      button { display: inline-flex; align-items: center; justify-content: center; border: 0; background: transparent; color: var(--text); width: 32px; height: 36px; padding: 0; cursor: pointer; }
      .menu-toggle, .sun { display: none; }
      :global([data-theme="dark"]) .moon { display: none; }
      :global([data-theme="dark"]) .sun { display: block; }
      main { padding-top: 93px; padding-bottom: 48px; min-height: calc(100vh - 57px); }
      .profile-header { margin-bottom: 28px; scroll-margin-top: 90px; }
      h1 { font-size: 32px; line-height: 1.3; font-weight: 700; margin: 0 0 8px; letter-spacing: -.7px; }
      .name-divider { margin-inline: 5px; font-weight: 400; }
      .name-ja { letter-spacing: 0; }
      .affiliation { margin: 0 0 3px; color: var(--muted); }
      .interests { margin: 0; font-size: 15px; color: var(--muted); }
      .interests span { padding-inline: 5px; }
      p { margin: 0 0 16px; }
      section { margin-bottom: 42px; scroll-margin-top: 82px; }
      .biography { margin-bottom: 36px; }
      .biography p { max-width: 850px; }
      .links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 24px; margin-bottom: 0; }
      .links a { font-size: 15px; font-weight: 500; }
      .links span { color: var(--muted); }
      h2 { font-size: 26px; font-weight: 400; line-height: 1.4; margin: 0 0 20px; padding-bottom: 5px; border-bottom: 1px solid var(--divider); letter-spacing: -.4px; }
      h3 { margin: 28px 0 12px; font-size: 17px; font-weight: 600; }
      .research-item { display: grid; grid-template-columns: 240px 1fr; column-gap: 28px; margin-bottom: 15px; }
      .research-item h3 { font-size: 16px; margin: 0; }
      .research-item p { margin: 0; color: var(--muted); font-size: 15px; }
      .publications { padding-left: 24px; margin: 12px 0 28px; }
      .publications li { padding-left: 7px; margin-bottom: 22px; line-height: 1.75; }
      .publications li::marker { color: var(--muted); font-size: 13px; }
      .publications strong { font-weight: 600; }
      .publications em { color: var(--muted); }
      .awards { list-style: none; padding: 0; }
      .awards li { padding-block: 12px; border-bottom: 1px solid var(--divider); }
      #contact { margin-bottom: 0; }
      footer { background: #1c1c1d; color: #e0e0e0; font-size: 13px; padding: 18px 0; }
      .footer-inner { text-align: center; }
      footer span { color: #aaa; margin-left: 8px; }
      .back-to-top { position: fixed; bottom: 25px; right: 25px; border-radius: 4px; background: var(--text); color: var(--background); width: 34px; height: 34px; display: grid; place-items: center; opacity: 0; visibility: hidden; transition: opacity .15s; }
      .back-to-top.visible { opacity: .75; visibility: visible; }
      .skip-link { position: fixed; top: -100px; left: 16px; z-index: 30; background: var(--background); padding: 8px 16px; }
      .skip-link:focus { top: 8px; }
      @media (max-width: 800px) {
        .menu-toggle { display: inline-flex; }
        nav { display: none; position: absolute; top: 56px; left: 0; right: 0; background: var(--background); padding: 12px 24px 20px; border-bottom: 1px solid var(--divider); align-items: stretch; gap: 0; }
        nav.open { display: flex; flex-direction: column; }
        nav a { padding: 9px 0; }
        .nav-controls { gap: 8px; }
      }
      @media (max-width: 575px) {
        .nav-inner, main, .footer-inner { padding-inline: 22px; }
        main { padding-top: 85px; }
        h1 { font-size: 29px; }
        .name-divider { display: none; }
        .name-ja { display: block; font-size: 23px; margin-top: 5px; }
        .affiliation { font-size: 15px; margin-top: 12px; }
        .interests { font-size: 13px; margin-top: 8px; }
        .interests span { padding-inline: 1px; }
        h2 { font-size: 24px; }
        .research-item { grid-template-columns: 1fr; gap: 4px; margin-bottom: 20px; }
        .publications { padding-left: 18px; font-size: 15px; }
        .publications li { padding-left: 3px; }
        footer span { display: block; margin: 2px 0 0; }
      }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .back-to-top { transition: none; } }
    </style>
  </body>
</html>
